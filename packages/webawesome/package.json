{
  "name": "@herdingbits/trailhead-webawesome",
  "version": "0.4.1",
  "description": "Web Awesome web components adapter for Trailhead. Vanilla TypeScript, no React required.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell.css": "./dist/shell.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && cp src/shell.css dist/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@awesome.me/webawesome": "^3.6.0",
    "@herdingbits/trailhead-core": "^0.4.0"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "@herdingbits/trailhead-types": "^0.4.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "micro-frontend",
    "webawesome",
    "web-awesome",
    "adapter",
    "trailhead"
  ],
  "author": "HerdingBits",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quicken/trailhead.git",
    "directory": "packages/webawesome"
  }
}
